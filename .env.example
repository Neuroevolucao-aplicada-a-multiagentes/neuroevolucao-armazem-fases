# Credenciais do Supabase para a persistencia dos dados de treinamento.
# Copie para .env e preencha. O .env NAO deve ser versionado.
#
# Onde obter (painel do Supabase):
#   Project Settings > API
#     SUPABASE_URL  = "Project URL"
#     SUPABASE_KEY  = chave "service_role"
#
# A chave precisa ser a service_role: as migrations concedem as permissoes
# do schema "core" a esse papel. A service_role ignora RLS e nunca deve ser
# exposta em cliente publico nem commitada.
#
# Antes do primeiro uso, aplicar as migrations de supabase/migrations/ na
# ordem do prefixo numerico e garantir que o schema "core" esteja na lista
# de schemas expostos pela Data API.

SUPABASE_URL=
SUPABASE_KEY=
