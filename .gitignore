# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Ambiente virtual
venv/
.env/
.env

# VSCode
.vscode/

# Arquivos do sistema
.DS_Store
Thumbs.db

# Logs
*.log

# Arquivos temporários
*.tmp

# Pesos/modelos salvos (reproduziveis via treino)
*.npz
# excecao: os checkpoints das fases sao o resultado do trabalho,
# pesam ~10 KB e nao sao reproduziveis sem repetir dias de treino
!melhor_rede_fase*.npz
*.npz.bak

# Resultados individuais de execucao (CSVs + PNGs gerados por treino)
runs/

# Midia gerada
*.mp4
*.jpg

# Banco de dados
*.db

# Ignora PNGs em qualquer lugar, MAS preserva os da pasta figuras/
*.png
!figuras/*.png
